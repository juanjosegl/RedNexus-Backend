# API
PORT=3000
NODE_ENV=development

# PostgreSQL + pgvector (docker compose)
DATABASE_URL=postgresql://rednexus:rednexus@localhost:5432/rednexus

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Proveedor de IA: mock (por defecto, sin red, respuestas determinísticas) u ollama
AI_PROVIDER=mock

# Nodo de IA (Ollama). Si Ollama corre en la Mac del lider, usa su IP de la red local.
OLLAMA_URL=http://localhost:11434
# IA-07: qwen2.5:3b y paraphrase-multilingual (768 dimensiones, mejor en español que nomic-embed-text)
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=paraphrase-multilingual
OLLAMA_TIMEOUT_MS=20000

# Autenticacion
JWT_SECRET=cambia-esto-en-tu-env

# Emparejamiento (IA-07): por defecto, la configuración ganadora de MLflow (rednexus-matching).
# Solo cámbialas para probar otra versión; ver RedNexus-Platform/ml/README.md
# MATCH_CONFIG_VERSION=1
# MATCH_SIMILARITY_WEIGHT=0.8
# MATCH_MIN_SIMILARITY=0.25
# MATCH_HYBRID_ALPHA=0.6
# MATCH_ENRICH_QUERY=true
