# API
PORT=3000
NODE_ENV=development

# PostgreSQL + pgvector (docker compose)
DATABASE_URL=postgresql://rednexus:rednexus@localhost:5432/rednexus

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Proveedor de IA: mock (por defecto, sin red, respuestas determinísticas) u ollama
AI_PROVIDER=mock

# Nodo de IA (Ollama). Si Ollama corre en la Mac del lider, usa su IP de la red local.
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=20000

# Autenticacion
JWT_SECRET=cambia-esto-en-tu-env

# Notas de voz: mock (texto fijo) o whisper (servidor de whisper.cpp en el nodo de IA)
# whisper-server -m ggml-base.bin --convert --host 0.0.0.0 --port 8178
TRANSCRIBE_PROVIDER=mock
WHISPER_URL=http://localhost:8178
WHISPER_LANGUAGE=es
WHISPER_TIMEOUT_MS=120000
